<Window x:Class="Lab1.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1"
        mc:Ignorable="d"
        Title="Контракт операции"
        Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="contractHeader"
                   Grid.Row="0"
                   Text="Контракт операции"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 1. Предисловия (Pre) -->
                <GroupBox Header="Предисловия (Pre)" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="preBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>

                <!-- 2. Постусловия (Post) -->
                <GroupBox Header="Постусловия (Post)" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="postBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>

                <!-- 3. Эффекты -->
                <GroupBox Header="Эффекты" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="effectsBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>

                <!-- 4. Исключения -->
                <GroupBox Header="Исключения" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="exceptionsBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>

                <!-- Граничные примеры -->
                <TextBlock Text="Граничные примеры"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <GroupBox Header="Пример: валидный вход" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="correctExampleBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>
                <GroupBox Header="Пример: невалидный вход" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="incorrectExampleBlock"
                               Text=""
                               TextWrapping="Wrap"
                               MinHeight="40"/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2"
                Content="Закрыть"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>