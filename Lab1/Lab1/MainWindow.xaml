<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1"
        mc:Ignorable="d"
        Title="Lab1 — Контракты и wp-калькулятор"
        Height="700" Width="1100"
        Background="#F4F7F6">

    <Window.Resources>
        <!--Стиль для кнопок-->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <!--Синий цвет-->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <!--Темнее при наведении-->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#9CA3AF"/>
                                <!--Серый, если выключена-->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Стиль для текстовых полей-->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="5" Background="White">

        <!--ВКЛАДКА 1-->
        <TabItem Header="Операции каршеринга">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Левая половина-->
                <Grid Grid.Column="0" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Выбор операции"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="operationsListBox"
                             Grid.Row="1"
                             SelectionChanged="OperationsListBox_SelectionChanged"/>
                </Grid>

                <!--Правая половина-->
                <Grid Grid.Column="1" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="parametersHeader"
                               Grid.Row="0"
                               Text="Ввод параметров"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">

                        <!--Начать аренду-->
                        <StackPanel x:Name="rentParametersGroup"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Параметры: Начать аренду"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <CheckBox x:Name="chkCarAvailable"
                                      Content="Авто доступно"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>
                            <CheckBox x:Name="chkUserLoggedIn"
                                      Content="Пользователь авторизован"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>
                            <CheckBox x:Name="chkActiveRent"
                                      Content="Пользователь имеет активную аренду"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>
                        </StackPanel>

                        <!--Завершить аренду-->
                        <StackPanel x:Name="returnParametersGroup"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Параметры: Завершить аренду"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <CheckBox x:Name="chkReturnUserLoggedIn"
                                      Content="Пользователь авторизован"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>
                            <CheckBox x:Name="chkReturnActiveRent"
                                      Content="Пользователь имеет активную аренду"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>

                            <TextBlock Text="Баланс" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtBalance"
                                     Text="0"
                                     Margin="0,2,0,5"
                                     TextChanged="TextBox_ParameterChanged"/>

                            <TextBlock Text="Тариф (за единицу расстояния)" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtTariff"
                                     Text="0"
                                     Margin="0,2,0,5"
                                     TextChanged="TextBox_ParameterChanged"/>

                            <TextBlock Text="Расстояние (целое число)" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtDistance"
                                     Text="0"
                                     Margin="0,2,0,5"
                                     TextChanged="TextBox_ParameterChanged"/>
                        </StackPanel>

                        <!--Пополнить баланс-->
                        <StackPanel x:Name="topUpParametersGroup"
                                    Visibility="Collapsed"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Параметры: Пополнить баланс"
                                       FontWeight="Bold"
                                       Margin="0,0,0,5"/>

                            <CheckBox x:Name="chkTopUpUserLoggedIn"
                                      Content="Пользователь авторизован"
                                      Margin="0,5,0,0"
                                      Checked="CheckBox_StateChanged"
                                      Unchecked="CheckBox_StateChanged"/>

                            <TextBlock Text="Текущий баланс" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtTopUpBalance"
                                     Text="0"
                                     Margin="0,2,0,5"
                                     TextChanged="TextBox_ParameterChanged"/>

                            <TextBlock Text="Сумма пополнения" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtTopUpValue"
                                     Text="0"
                                     Margin="0,2,0,5"
                                     TextChanged="TextBox_ParameterChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Content="Выполнить"
                            Height="35"
                            Margin="0,10,0,0"
                            Click="ExecuteButton_Click"/>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="Результат"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="resultTextBox"
                                 Height="60"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Background="#F8FAFC"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Pre" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Rectangle x:Name="preIndicator"
                                       Width="20" Height="20"
                                       Fill="LightGray" Stroke="Gray" RadiusX="10" RadiusY="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Post" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <Rectangle x:Name="postIndicator"
                                       Width="20" Height="20"
                                       Fill="LightGray" Stroke="Gray" RadiusX="10" RadiusY="10"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="5"
                            Content="Сбросить"
                            Height="35"
                            Margin="0,10,0,0"
                            Background="#EF4444"
                            Click="ResetButton_Click"/>

                    <Button Grid.Row="6"
                            Content="Показать контракт"
                            Height="35"
                            Margin="0,15,0,0"
                            Background="#10B981"
                            Click="ContractShowButton_Click"/>
                </Grid>
            </Grid>
        </TabItem>

        <!--ВКЛАДКА 2 -->
        <TabItem Header="Конструктор фрагмента">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--ВВОД-->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Цель (Post)" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPostCondition"
                                 Height="32"
                                 Margin="0,0,0,5"
                                 Text="max > 100"/>
                        <TextBlock x:Name="txtPostHumanReadable"
                                   Text="Постусловие: максимум больше 100"
                                   FontStyle="Italic"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="Код фрагмента (без циклов)" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFragmentCode"
                                 Height="200"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Margin="0,0,0,5"
                                 Text="if (x1 >= x2) { max := x1; } else { max := x2; }"/>
                        <TextBlock Text="Поддерживается: x := expr; if (B) { S1 } else { S2 }; + - * / abs() sqrt(), сравнения, &amp;&amp;, ||"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="btnCalculateWp"
                                    Content="Рассчитать wp"
                                    Width="160" Height="38"
                                    Margin="0,0,10,0"
                                    Click="CalculateWpButton_Click"/>
                            <Button x:Name="btnShowTriad"
                                    Content="Показать триаду"
                                    IsEnabled="False"
                                    Width="160" Height="38"
                                    Click="ShowTriadButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="Пресеты (обязательные сценарии)" FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Button x:Name="btnPresetMax"
                                    Content="Max из двух"
                                    Width="120" Height="32"
                                    Margin="0,0,5,0"
                                    Background="#10B981"
                                    Click="PresetMaxButton_Click"/>
                            <Button x:Name="btnPresetQuadratic"
                                    Content="Квадратное уравнение"
                                    Width="150" Height="32"
                                    Margin="0,0,5,0"
                                    Background="#10B981"
                                    Click="PresetQuadraticButton_Click"/>
                            <Button x:Name="btnPresetSequence"
                                    Content="Последовательность"
                                    Width="130" Height="32"
                                    Background="#10B981"
                                    Click="PresetSequenceButton_Click"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!--Разделитель-->
                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#E2E8F0" DragDelta="GridSplitter_DragDelta"/>

                <!--ВЫВОД-->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Пошаговый трейс" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTrace"
                                 Height="150"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="#F8FAFC"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Итоговое wp (кратко)" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtWpShort"
                                 Height="60"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="#F8FAFC"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Итоговое wp (человеческим языком)" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtWpHumanReadable"
                                 Height="80"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFC"
                                 Margin="0,0,0,15"/>

                        <TextBlock Text="Триада Хоара" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtTriad"
                                 Height="80"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Background="#F8FAFC"
                                 Margin="0,0,0,15"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>
</Window>